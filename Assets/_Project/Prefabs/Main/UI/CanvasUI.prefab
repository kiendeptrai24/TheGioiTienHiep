    m_Options:
    - m_Text: "Ph\xE0m Nh\xE2n Luy\u1EC7n Linh Quy\u1EBFt"
      m_Image: {fileID: 21300000, guid: 8ed6d35fd66658644a8d71238246a699, type: 3}
      m_Color: {r: 1, g: 1, b: 1, a: 0}
    - m_Text: "Linh V\u1EADn Quy\u1EBFt"
      m_Image: {fileID: 21300000, guid: 8ed6d35fd66658644a8d71238246a699, type: 3}
      m_Color: {r: 1, g: 1, b: 1, a: 0}
    - m_Text: "Y\xEAu Linh Quy\u1EBFt"
      m_Image: {fileID: 21300000, guid: 8ed6d35fd66658644a8d71238246a699, type: 3}
      m_Color: {r: 1, g: 1, b: 1, a: 0}
